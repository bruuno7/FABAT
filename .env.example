# Copia este fichero a `.env` (está en .gitignore) y rellena SOLO lo que vayas a usar.
# Sin nada relleno, el MVP funciona entero en local con todo simulado.

# --- Servidor ---
MANDO_PORT=8000
MANDO_CASE=demo-1            # demo-N, demo-gates, o un id de demo.jsonl / heldout.jsonl
MANDO_SPEED=1                # minutos simulados por segundo real
MANDO_PUBLIC_URL=            # URL https del túnel (cloudflared) cuando HappyRobot tenga que llamarnos
MANDO_OPERATOR_TOKEN=        # obligatorio si hay URL pública: protege la pantalla de mando y el botón de aprobar
MANDO_MCP_TOKEN=             # protege nuestro servidor MCP (/mcp)
MANDO_OPERATIONAL=0          # 1 = autoridad duradera SQLite; no usa el reloj de simulación
MANDO_OPERATIONAL_DB=motor/server/data/operations.sqlite
MANDO_EXTERNAL_DELIVERY=0    # 1 solo con proveedores y listas blancas ya configurados
MANDO_BRIDGE_SECRET=         # secreto distinto usado por puente/ -> /api/operations/telegram
MANDO_CONTROL_CHAT_ID=       # chat privado del centro de control, nunca se versiona

# --- HappyRobot (clúster EU) ---
# Los slugs incluidos son marcadores: configura los reales en .env mediante HR_WORKFLOW_DISPATCH/WEBCALL/VOICE/INTAKE/CHAT (prefijo HR_WORKFLOW_ en cada variable) o URLs explícitas HR_HOOK_DISPATCH, HR_DISPATCH_WEBCALL_URL, HR_WEBCALL_PUBLIC_URL, HR_HOOK_INTAKE y HR_CHAT_PUBLIC_URL; las URLs prevalecen.
MANDO_COMMS=sim              # sim | happyrobot
MANDO_VOICE_MODE=phone       # phone (número Telnyx, llamadas salientes) | web_call
HR_API_BASE=https://platform.eu.happyrobot.ai/api/v2
HR_API_KEY=                  # NUNCA en el repo
HR_LAUNCH_MODE=hook          # hook | runs
HR_HOOK_DISPATCH=            # URL del webhook del workflow mando-despacho-telefono
HR_HOOK_INTAKE=              # URL del webhook del workflow mando-ingesta-texto
HR_SECRET=                   # secreto compartido: HappyRobot nos lo devuelve en la cabecera X-Mando-Token
HR_WORKFLOW_DISPATCH=        # UUID/slug publicado de mando-despacho-telefono
HR_WORKFLOW_RAPIDO=          # UUID/slug publicado de prueba-ana-rapido
# Coordinación por Telegram delegada en HappyRobot: slug/UUID de fa-despacho-tg. Si está,
# toda la coordinación por Telegram la entrega HappyRobot (él manda el mensaje y conversa);
# sin ella, MANDO usa su propio bot de Telegram.
HR_WORKFLOW_TG_OFFER=
# 1 = los avisos que entran por el bot los coordina HappyRobot; MANDO sólo espeja y acepta
# un override explícito del operador. 0 = MANDO vuelve a auto-ofertar esos avisos.
MANDO_HAPPYROBOT_DECIDES=1
# Hooks de Telegram de HappyRobot que usa MANDO para delegar la coordinación:
HR_HOOK_TG=                  # Incoming Hook development de fa-entrada-tg (recibe el aviso)
HR_HOOK_TG_RESPONSE=         # Incoming Hook de fa-respuesta-tg (botones del personal)
HR_HOOK_TG_ROSTER=           # Incoming Hook de fa-rol-tg; en un override MANDO asigna ahí el puesto de esa persona
HR_ENV=development
MANDO_CEREBRO=reglas         # simulador: reglas | agente | hibrido | abanico
MANDO_CEREBRO_TIMEOUT_S=90
MANDO_ABANICO_TIMEOUT_S=90
HR_AGENTE_TRIAJE=
HR_AGENTE_PRIORIDAD=
HR_AGENTE_RECURSOS=
HR_AGENTE_AVISOS=
HR_AGENTE_VIGIA=
HR_AGENTE_CRITICO=
HR_WEBCALL_PUBLIC_URL=       # enlace de la Web call de avisos para el público
HR_INTAKE_EMAIL=             # dirección @happyrobotmail.com de avisos
HR_SMS_NUMBER=               # número para SMS de avisos
MANDO_ALLOWED_NUMBERS=       # lista blanca de móviles a los que se puede llamar, separados por comas. Sin ella no se llama a nadie
MANDO_CONTACTS=motor/server/contacts.local.json
# En phone: qué clases salen a HappyRobot (resto → sim). Por defecto evita Runs basura de ASK/NOTIFY.
MANDO_HR_PHONE_KINDS=dispatch,recall,resupply
# Máximo de llamadas PSTN reales a la vez (1 evita ráfagas a ×16). Rango 1–5.
MANDO_HR_MAX_INFLIGHT=1
HR_FALLBACK_S=45             # segundos reales antes de caer a sim si HR no responde
# Auditoría durable de llamadas (SQLite local). Ignorado por git. Vacío = motor/server/data/ledger.sqlite
MANDO_LEDGER_PATH=motor/server/data/ledger.sqlite
# Directorio Telegram rol↔chat_id (privado). Por defecto motor/server/data/tg_roster.db; off = solo memoria.
MANDO_TG_ROSTER=

# --- LLM avisos libres (Helmcode / Cloudflare AI Gateway / Vercel AI Gateway) ---
# Por defecto APAGADO: el banco y la demo usan solo el heurístico (no gasta tokens).
# Persona: poner la clave del crédito Helmcode (o la del Gateway) y MANDO_LLM=1 solo en demo.
MANDO_LLM=0
AGENTES_LLM_KEY=             # o HELMCODE_API_KEY=  NUNCA en el repo
AGENTES_LLM_BASE=https://api.helmcode.com/v1
# Cloudflare AI Gateway (prioridad 2): sustituye la BASE por la URL del gateway, misma KEY si aplica.
#   AGENTES_LLM_BASE=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/compat
# Vercel AI Gateway (fallback 2º): solo si Cloudflare no basta.
AGENTES_LLM_MODEL=deepseek-v4-flash

# --- Exa (solo pitch / fuentes; fuera del motor) ---
EXA_API_KEY=                 # NUNCA en el repo. Gastar requiere OK de persona.
# EXA_RUN=1                  # hace falta además para que el script llame a la API

# --- Telegram (canal del público y del jurado) ---
TELEGRAM_BOT_TOKEN=          # de @BotFather. NUNCA en el repo
TELEGRAM_BOT_USERNAME=
