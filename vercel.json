{
  "framework": null,
  "installCommand": "npm install && npm --prefix puente install",
  "buildCommand": "npm --prefix puente run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "includeFiles": "puente/dist/**",
      "maxDuration": 30
    }
  }
}
