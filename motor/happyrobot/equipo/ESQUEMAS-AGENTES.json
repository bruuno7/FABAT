{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "triaje": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "clasificacion",
        "fusionar_con",
        "cambios",
        "descartes",
        "faltantes",
        "pregunta_unica",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-agente-triaje"
        },
        "clasificacion": {
          "enum": [
            "nuevo",
            "duplicado",
            "rumor",
            "broma",
            "desmentido",
            "correccion"
          ]
        },
        "fusionar_con": {
          "type": [
            "string",
            "null"
          ]
        },
        "cambios": {
          "type": "array"
        },
        "descartes": {
          "type": "array"
        },
        "faltantes": {
          "type": "array"
        },
        "pregunta_unica": {
          "type": [
            "string",
            "null"
          ]
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "prioridad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "cola",
        "medios_restantes",
        "sin_atender",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-agente-prioridad"
        },
        "cola": {
          "type": "array"
        },
        "medios_restantes": {
          "type": "array"
        },
        "sin_atender": {
          "type": "array"
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "recursos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "asignaciones",
        "esperas",
        "alternativas",
        "elegida",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-agente-recursos"
        },
        "asignaciones": {
          "type": "array"
        },
        "esperas": {
          "type": "array"
        },
        "alternativas": {
          "type": "array"
        },
        "elegida": {
          "type": [
            "string",
            "null"
          ]
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "avisos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "avisos",
        "pendientes",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-agente-avisos"
        },
        "avisos": {
          "type": "array"
        },
        "pendientes": {
          "type": "array"
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "vigia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "sigue_valido",
        "supuestos_rotos",
        "afectados",
        "relanzar",
        "riesgo_vital",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-agente-vigia"
        },
        "sigue_valido": {
          "type": "boolean"
        },
        "supuestos_rotos": {
          "type": "array"
        },
        "afectados": {
          "type": "array"
        },
        "relanzar": {
          "type": "array"
        },
        "riesgo_vital": {
          "type": "boolean"
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "critico": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "veredicto",
        "correcciones",
        "barandillas",
        "lecciones_revisadas",
        "vital_sin_atender",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-agente-critico"
        },
        "veredicto": {
          "enum": [
            "APROBAR",
            "CORREGIR",
            "ESCALAR A PERSONA"
          ]
        },
        "correcciones": {
          "type": "array"
        },
        "barandillas": {
          "type": "array"
        },
        "lecciones_revisadas": {
          "type": "array"
        },
        "vital_sin_atender": {
          "type": "array"
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "equipo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agente",
        "estado",
        "decision",
        "agentes",
        "respuesta_informante",
        "razonamiento",
        "confianza",
        "supuestos"
      ],
      "properties": {
        "agente": {
          "const": "mando-equipo"
        },
        "estado": {
          "enum": [
            "aplicado",
            "pendiente_persona",
            "corregir",
            "sin_cambio",
            "error"
          ]
        },
        "decision": {
          "type": "object"
        },
        "agentes": {
          "type": "array"
        },
        "respuesta_informante": {
          "type": "string"
        },
        "razonamiento": {
          "type": "string",
          "minLength": 1
        },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supuestos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hecho",
              "invalidar_si"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hecho": {
                "type": "string"
              },
              "invalidar_si": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "entrada": {
      "type": "object",
      "required": [
        "tipo",
        "correlation_id",
        "canal",
        "texto",
        "riesgo_vital"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "entrada",
            "cambio"
          ]
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "canal": {
          "enum": [
            "telegram",
            "voice",
            "email",
            "sms",
            "web",
            "sensor",
            "gemelo",
            "operador"
          ]
        },
        "texto": {
          "type": "string"
        },
        "riesgo_vital": {
          "type": "boolean"
        },
        "zona": {
          "type": [
            "string",
            "null"
          ]
        },
        "tipo_incidente": {
          "type": "string"
        },
        "idioma": {
          "type": "string"
        },
        "contexto": {
          "type": "object"
        },
        "plan": {
          "type": "object"
        },
        "cambio": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "cambio"
              }
            }
          },
          "then": {
            "required": [
              "plan",
              "cambio"
            ]
          }
        }
      ]
    }
  }
}
