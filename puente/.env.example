# Copiar a .env — NUNCA commitear .env con valores reales

PORT=8787
ALLOW_DEMO_INJECT=1

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# poll = local sin HTTPS | webhook = Vercel / túnel
TELEGRAM_MODE=poll

# HappyRobot EU — Incoming Hook de fa-entrada-tg
HR_CLUSTER=eu
HR_API_KEY=
HR_HOOK_TG=
# Incoming Hook development de fa-respuesta-tg (botones del personal). Si falta, el callback se ignora.
HR_HOOK_TG_RESPONSE=
# Incoming Hook development de fa-rol-tg (/rol, /baja, /estado → directorio en Redis vía HappyRobot).
HR_HOOK_TG_ROSTER=
HR_HOOK_API_KEY=
HR_SECRET=
# PIN compartido para /rol. Obligatorio en Vercel/producción. Nunca en git.
STAFF_PIN=
HR_WORKFLOW_WEBCALL=
HR_WORKFLOW_TG=

# URL pública del puente (Vercel): https://TU-PROYECTO.vercel.app
MANDO_CALLBACK_URL=http://127.0.0.1:8787
# Backend MANDO público (túnel o despliegue persistente); el puente añade /hr/events
# Sin HR_HOOK_TG_ROSTER, recibe el fallback legado POST /hr/tg/roster.
MANDO_BACKEND_URL=
