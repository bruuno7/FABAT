{
  "installCommand": "npm install && npm --prefix motor/server install",
  "buildCommand": "npm --prefix motor/server run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "includeFiles": "motor/server/dist/**",
      "maxDuration": 30
    }
  }
}
