 "protocols": [
  {
   "id": "person_down",
   "family": "medical",
   "label": {
    "es": "Persona que no responde",
    "en": "Unresponsive person"
   },
   "triggers": {
    "es": [
     "desmay",
     "desvanec",
     "inconsciente",
     "no responde",
     "no reacciona",
     "no respira",
     "se ha caido redond",
     "tirado en el suelo",
     "tirada en el suelo",
     "tendido en el suelo",
     "tendida en el suelo",
     "no se mueve",
     "no se despierta",
     "no despierta",
     "perdido el conocimiento",
     "sin pulso",
     "infarto",
     "parada cardiaca",
     "convulsi",
     "se ha desplomado"
    ],
    "en": [
     "fainted",
     "passed out",
     "collapsed",
     "unconscious",
     "unresponsive",
     "not breathing",
     "isn t breathing",
     "not responding",
     "not moving",
     "no pulse",
     "heart attack",
     "blacked out",
     "seizure",
     "won t wake"
    ]
   },
   "sensitive": false,
   "slots": [
    {
     "id": "location",
     "critical": true,
     "type": "zone_point",
     "question": {
      "es": "¿Dónde estás exactamente?",
      "en": "Where exactly are you?"
     },
     "why": {
      "es": "sin saber dónde no puedo mandar a nadie",
      "en": "without a place I cannot send anyone"
     }
    },
    {
     "id": "responsive",
     "critical": true,
     "type": "bool",
     "question": {
      "es": "¿Te responde si le hablas o le tocas el hombro?",
      "en": "Do they respond if you talk to them or tap their shoulder?"
     },
     "why": {
      "es": "si no responde es riesgo vital y sale el equipo más cercano",
      "en": "if they do not respond it is life-threatening and the nearest team goes"
     }
    },
    {
     "id": "breathing",
     "critical": true,
     "type": "bool",
     "question": {
      "es": "¿Respira con normalidad? Mira si se le mueve el pecho.",
      "en": "Are they breathing normally? Watch if the chest moves."
     },
     "why": {
      "es": "sin saber si respira no sé si es una parada",
      "en": "without knowing if they breathe I cannot tell if it is a cardiac arrest"
     }
    },
    {
     "id": "seizure",
     "critical": false,
     "type": "bool",
     "question": {
      "es": "¿Tiene convulsiones?",
      "en": "Are they having a seizure?"
     },
     "why": {
      "es": "cambia lo que hay que hacer mientras llegan",
      "en": "it changes what to do until help arrives"
     }
    },
    {
     "id": "intox",
     "critical": false,
     "type": "bool",
     "ask_if": {
      "responsive": false,
      "breathing": true
     },
     "question": {
      "es": "¿Sabes si ha bebido o ha tomado algo?",
      "en": "Do you know if they drank or took something?"
     },
     "why": {
      "es": "el equipo sanitario lleva otro material",
      "en": "the medical team brings different equipment"
     }
    },
    {
     "id": "count",
     "critical": false,
     "type": "number",
     "question": {
      "es": "¿Cuántas personas están así?",
      "en": "How many people are like this?"
     },
     "why": {
      "es": "con más de una persona salen más equipos",
      "en": "more than one person means more teams"
     }
    }
   ],
   "red_flags": [
    {
     "if": {
      "breathing": false
     },
     "then": {
      "life_risk": true,
      "severity_min": 10,
      "needs": {
       "medical": 1,
       "ambulance": 1
      },
      "instruction": "cpr_hands_only",
      "dispatch_now": true
     }
    },
    {
     "if": {
      "responsive": [
       false,
       "unknown"
      ],
      "breathing": true
     },
     "then": {
      "life_risk": true,
      "severity_min": 9,
      "needs": {
       "medical": 1
      },
      "instruction": "recovery_position",
      "dispatch_now": true
     }
    },
    {
     "if": {
      "responsive": [
       false,
       "unknown"
      ]
     },
     "then": {
      "life_risk": true,
      "severity_min": 9,
      "needs": {
       "medical": 1
      },
      "instruction": "not_responding",
      "dispatch_now": true
     }
    },
    {
     "if": {
      "responsive": true,
      "breathing": "unknown"
     },
     "then": {
      "life_risk": true,
      "severity_min": 9,
      "needs": {
       "medical": 1
      },
      "instruction": "not_responding",
      "dispatch_now": true
     }
    },
    {
     "if": {
      "seizure": true
     },
     "then": {
      "life_risk": false,
      "severity_min": 8,
      "needs": {
       "medical": 1
      },
      "instruction": "seizure",
      "dispatch_now": true
     }
    }
   ],
   "dispatch_as_soon_as": [
    "location"
   ],
   "instructions": [
    {
     "id": "cpr_hands_only",
     "steps": {
      "es": [
       "Que otra persona vaya a por el personal con chaleco y pida un desfibrilador.",
       "Pon a la persona boca arriba en el suelo.",
       "Aprieta fuerte y rápido en el centro del pecho, solo con las manos.",
       "No pares hasta que llegue el equipo."
      ],
      "en": [
       "Send someone else to fetch staff in vests and ask for a defibrillator.",
       "Lay the person on their back on the ground.",
       "Push hard and fast in the centre of the chest, hands only.",
       "Do not stop until the team arrives."
      ]
     },
     "source": "consejo/seguridad-eventos.md Anexo C, clave not_responding (RCP solo con las manos); sin verificar fuera del dictamen"
    },
    {
     "id": "not_responding",
     "steps": {
      "es": [
       "Quédate con la persona.",
       "Que otro vaya a por el personal con chaleco y pida un desfibrilador.",
       "Si no respira normal: aprieta fuerte y rápido en el centro del pecho, sin parar."
      ],
      "en": [
       "Stay with the person.",
       "Send someone else to fetch staff in vests and ask for a defibrillator.",
       "If they are not breathing normally: push hard and fast in the centre of the chest, without stopping."
      ]
     },
     "source": "consejo/seguridad-eventos.md Anexo C, clave not_responding"
    },
    {
     "id": "recovery_position",
     "steps": {
      "es": [
       "Si respira, ponla de lado.",
       "No la dejes sola.",
       "Vigila que siga respirando."
      ],
      "en": [
       "If they are breathing, roll them onto their side.",
       "Do not leave them alone.",
       "Keep checking that they are still breathing."
      ]
     },
     "source": "consejo/seguridad-eventos.md Anexo C, clave unconscious_breathing"
    },
    {
     "id": "seizure",
     "steps": {
      "es": [
       "No la sujetes ni le metas nada en la boca.",
       "Aparta lo que pueda golpearla.",
       "Cuando pare, ponla de lado."
      ],
      "en": [
       "Do not hold them down or put anything in their mouth.",
       "Move away anything that could hit them.",
       "When it stops, roll them onto their side."
      ]
     },
     "source": "consejo/seguridad-eventos.md Anexo C, clave seizure"
    }
   ],
   "handoff": {
    "to": "medical_lead",
    "when": "life_risk"
   },
   "mando_type_hint": "fainting",
   "sources": [
    "consejo/seguridad-eventos.md (Anexo C y D)",
    "motor/happyrobot/NORTHSTARS.md"
   ]
