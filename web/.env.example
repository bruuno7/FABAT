# Copiar a `.env.local` — NUNCA commitear con valores reales.

# --- HappyRobot (EU) ------------------------------------------------------
# Si `HR_HOOK_TG` está vacío, la app arranca en MODO SIMULADO:
# el extracto y la respuesta al ciudadano los genera `src/lib/hr-sim.ts`
# con reglas fijas (cero LLM), sin llamar a HappyRobot.
HR_HOOK_TG=
HR_HOOK_API_KEY=
# Secreto compartido: HappyRobot lo manda en `x-hr-secret` a /api/hr/events
HR_SECRET=
HR_WORKFLOW_WEBCALL=

# --- Telegram (canal gratis paralelo) -------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- MANDO ----------------------------------------------------------------
# URL pública de esta app (túnel Cloudflare en demo, dominio Vercel en prod).
MANDO_CALLBACK_URL=http://127.0.0.1:3000
# 1 = permite /api/demo/* aunque haya HR_HOOK_TG configurado.
ALLOW_DEMO_INJECT=1
